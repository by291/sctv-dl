{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "SCTV DL",
        "visible": false,
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "windows/uninstaller.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "headerImage": "windows/installer-header.bmp",
        "uninstallerHeaderImage": "windows/installer-header.bmp",
        "installerHooks": "windows/installer-hooks.nsh",
        "customLanguageFiles": { "SimpChinese": "windows/SimpChinese.nsh" }
      }
    }
  }
}

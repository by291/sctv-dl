; Override the stock SimSun font after NSIS loads its Simplified Chinese table.
SetFont /LANG=2052 "Microsoft YaHei UI" 9
BrandingText "SCTV DL"

LangString addOrReinstall ${LANG_SIMPCHINESE} "修复或重新安装"
LangString alreadyInstalled ${LANG_SIMPCHINESE} "已安装 SCTV DL"
LangString alreadyInstalledLong ${LANG_SIMPCHINESE} "已安装 ${PRODUCTNAME} ${VERSION}。请选择要执行的操作，然后点击“下一步”。"
LangString appRunning ${LANG_SIMPCHINESE} "{{product_name}} 正在运行，请先退出应用再继续。"
LangString appRunningOkKill ${LANG_SIMPCHINESE} "{{product_name}} 正在运行。$\n点击“确定”将强制关闭应用；尚未保存的进度可能丢失。"
LangString chooseMaintenanceOption ${LANG_SIMPCHINESE} "选择修复、重新安装或卸载应用。"
LangString choowHowToInstall ${LANG_SIMPCHINESE} "选择如何安装 ${PRODUCTNAME}。"
LangString createDesktop ${LANG_SIMPCHINESE} "创建桌面快捷方式"
LangString dontUninstall ${LANG_SIMPCHINESE} "保留现有安装并继续"
LangString dontUninstallDowngrade ${LANG_SIMPCHINESE} "保留现有版本（安装旧版本前必须先卸载）"
LangString failedToKillApp ${LANG_SIMPCHINESE} "无法关闭 {{product_name}}，请手动退出后重试。"
LangString installingWebview2 ${LANG_SIMPCHINESE} "正在安装应用所需的 WebView2 运行环境……"
LangString newerVersionInstalled ${LANG_SIMPCHINESE} "已安装更新版本的 ${PRODUCTNAME}。如需安装此旧版本，建议先卸载现有版本。请选择操作，然后点击“下一步”。"
LangString older ${LANG_SIMPCHINESE} "较旧"
LangString olderOrUnknownVersionInstalled ${LANG_SIMPCHINESE} "已检测到 ${PRODUCTNAME} 的$R4版本。建议先卸载现有版本。请选择操作，然后点击“下一步”。"
LangString silentDowngrades ${LANG_SIMPCHINESE} "此安装包不允许静默降级，请打开安装向导进行操作。$\n"
LangString unableToUninstall ${LANG_SIMPCHINESE} "卸载未能完成，请退出应用后重试。"
LangString uninstallApp ${LANG_SIMPCHINESE} "卸载 ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SIMPCHINESE} "先卸载现有版本，再安装"
LangString unknown ${LANG_SIMPCHINESE} "未知"
LangString webview2AbortError ${LANG_SIMPCHINESE} "WebView2 运行环境安装失败，应用暂时无法运行。请重新启动安装程序后重试。"
LangString webview2DownloadError ${LANG_SIMPCHINESE} "WebView2 下载失败：$0"
LangString webview2DownloadSuccess ${LANG_SIMPCHINESE} "WebView2 安装程序已下载"
LangString webview2Downloading ${LANG_SIMPCHINESE} "正在下载应用所需的 WebView2 运行环境……"
LangString webview2InstallError ${LANG_SIMPCHINESE} "WebView2 安装失败，错误代码：$1"
LangString webview2InstallSuccess ${LANG_SIMPCHINESE} "WebView2 运行环境已安装"
LangString deleteAppData ${LANG_SIMPCHINESE} "同时清除设置、收藏、观看历史和节目缓存"

; Page variables are declared by MUI/Tauri before language files are included.
!include "${SCTV_WINDOWS_DIR}\installer-ui.nsh"

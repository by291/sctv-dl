{
  "name": "sctv-dl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm docs:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:check": "node tooling/desktop-check.ts",
    "test:desktop": "vitest run .tauri.test.ts src/platform src/shared/platform shared/contracts tooling/desktop-release.test.ts",
    "docs:check": "remark --use remark-gfm --use remark-validate-links --frail --no-stdout --quiet \"*.md\" \"docs/**/*.md\" \"android/*.md\" \"flutter/*.md\" \"src-tauri/*.md\"",
    "ci:lint": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12"
  },
  "dependencies": {
    "@lucide/vue": "^1.53.0",
    "@tauri-apps/api": "2.12.4",
    "@vueuse/core": "^15.0.0",
    "artplayer": "^5.4.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "sirv": "^3.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-processor-vue-blocks": "^2.0.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}

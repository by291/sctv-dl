<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="sctv-user.db" />
        <include domain="database" path="sctv-user.db-wal" />
        <include domain="database" path="sctv-user.db-shm" />
        <include domain="database" path="sctv-user.db-journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="sctv-user.db" />
        <include domain="database" path="sctv-user.db-wal" />
        <include domain="database" path="sctv-user.db-shm" />
        <include domain="database" path="sctv-user.db-journal" />
    </device-transfer>
</data-extraction-rules>
